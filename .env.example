# Copiez ce fichier vers .env.local, puis renseignez les deux valeurs.

# Mot de passe d'accès à la page d'administration (/).
ADMIN_PASSWORD=

# Clé utilisée pour signer le cookie de session. Doit être longue et aléatoire.
# Générez-la avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
